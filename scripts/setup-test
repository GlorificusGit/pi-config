#!/usr/bin/env bash
# Set up an isolated Pi profile (~/.pi/test) for testing this checkout.

set -euo pipefail

repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
src=~/.pi/agent
dst=~/.pi/test

mkdir -p "$dst"

for f in auth.json models.json keybindings.json AGENTS.md; do
  [[ -e "$src/$f" ]] && ln -sfn "$src/$f" "$dst/$f"
done

cfg=$(cat "$src/settings.json" 2>/dev/null || echo '{}')
jq --arg pkg "$repo" 'del(.packages) | .packages = [$pkg]' <<<"$cfg" >"$dst/settings.json"

echo "Run: PI_CODING_AGENT_DIR=$dst pi"
